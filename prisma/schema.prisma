generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  password              String?
  name                  String
  enable                Boolean              @default(true)
  isEmailVerified       Boolean              @default(false)
  isOnboardingCompleted Boolean              @default(false)
  googleId              String?              @unique
  lastName              String?
  onboarding            OnboardingResponses?

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, code])
  @@map("email_verification_tokens")
}

model OnboardingResponses {
  id                      String               @id @default(cuid())
  userId                  String               @unique
  userRole                RoleEnum?
  familyType              FamilyTypeEnum?
  familyTypeOther         String?
  currentStage            StageEnum?
  trimester               TrimesterEnum?
  estimatedDueDate        DateTime?
  babyBirthDate           DateTime?
  licenseDuration         LicenseDurationEnum?
  licenseDurationOther    String?
  workModality            WorkModalityEnum?
  workModalityOther       String?

  // User data for step 1
  birthday                DateTime?
  city                    String?
  country                 String?
  genre                   String?
  phone                   String?
  userType                String?

  // Parental specific fields (step 2)
  currentEmploymentStatus String?
  jobRole                 String?
  numberOfChildren        String?
  organizationType        String?
  userDescription         String?

  learningTopics          String[]             @default([])
  preLicenseSupportNeeds  String[]             @default([])
  licenseSupportNeeds     String[]             @default([])
  postLicenseSupportNeeds String[]             @default([])
  is_onboarding_completed Boolean              @default(false)
  createdAt               DateTime             @default(now())
  completedAt             DateTime?
  updatedAt               DateTime             @updatedAt
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_responses")
}

enum StageEnum {
  PRE_LICENSE
  LICENSE
  POST_LICENSE
}

enum RoleEnum {
  MOTHER
  FATHER
  OTHER
}

enum FamilyTypeEnum {
  PADRE_MADRE
  MADRE_MADRE
  PADRE_PADRE
  MADRE
  PADRE
  OTHER
}

enum TrimesterEnum {
  TRIMESTER_1
  TRIMESTER_2
  TRIMESTER_3
}

enum LicenseDurationEnum {
  LESS_THAN_1_MONTH
  ONE_TO_3_MONTHS
  THREE_TO_6_MONTHS
  MORE_THAN_6_MONTHS
  OTHER
}

enum WorkModalityEnum {
  FULL_TIME_PRESENTIAL
  FULL_TIME_HYBRID
  FULL_TIME_REMOTE
  PART_TIME_PRESENTIAL
  PART_TIME_HYBRID
  PART_TIME_REMOTE
  OTHER
}
